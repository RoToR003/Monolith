# Copy this file to .env.local, then enter your OWN application credentials from:
# https://my.telegram.org/apps
# The committed .env contains public upstream development values, not your personal keys.
# Uncomment and replace the two lines below before a real deployment or personal use.
# VITE_API_ID=your_numeric_api_id
# VITE_API_HASH=your_api_hash
#
# Every VITE_* variable is visible in the browser bundle. Do not put account login codes,
# passwords, bot tokens, session strings, or backend secrets in this file.
